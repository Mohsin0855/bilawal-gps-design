<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/white">

    <TextView
        android:id="@+id/gps"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/baloo"
        android:text="GPS"
        android:textColor="#6366F1"
        android:textSize="30sp"
        android:layout_marginStart="14dp"
        android:layout_marginTop="54dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>

    <View
        android:id="@+id/gps_underline"
        android:layout_width="0dp"
        android:layout_height="3dp"
        android:layout_marginTop="-6dp"
        android:background="#6366F1"
        app:layout_constraintTop_toBottomOf="@id/gps"
        app:layout_constraintStart_toStartOf="@id/gps"
        app:layout_constraintEnd_toEndOf="@id/gps"/>

    <TextView
        android:id="@+id/map_camera"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/averia_serif_libre_bold"
        android:text="  Map Camera"
        android:textColor="#262537"
        android:textSize="22sp"
        android:layout_marginTop="63dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toEndOf="@id/gps"
        />
    <ImageView
        android:id="@+id/small_crown"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/small_crown"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginTop="65dp"
        app:layout_constraintStart_toEndOf="@id/map_camera"
        app:layout_constraintEnd_toEndOf="parent" />

    <ImageView
        android:id="@+id/setting"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/setting_icon"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginTop="66dp"
        android:layout_marginEnd="14dp"
        app:layout_constraintStart_toEndOf="@id/small_crown"
        app:layout_constraintEnd_toEndOf="parent" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/rectangle_box"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/home_rectangle"
        android:layout_marginTop="10dp"
        android:layout_marginHorizontal="50dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/gps_underline">

        <androidx.constraintlayout.widget.Guideline
            android:id="@id/guideline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintGuide_percent="0.35" />

        <TextView
            android:id="@+id/edit_photo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/poppins_semibold"
            android:text="Edit photo"
            android:textColor="@color/black"
            android:textSize="18sp"
            android:layout_marginTop="12dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toEndOf="@id/guideline"/>

        <TextView
            android:id="@+id/description"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Add location to \nyour existing photos"
            android:textSize="14sp"
            android:textColor="#A6AECB"
            android:layout_marginStart="20dp"
            android:fontFamily="@font/poppins_medium"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/edit_photo"/>

        <ImageView
            android:id="@+id/girl"
            android:layout_width="240dp"
            android:layout_height="150dp"
            android:src="@drawable/woman"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/guideline"
            app:layout_constraintTop_toTopOf="parent"/>

        <ImageView
            android:id="@+id/stars"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/stars"
            android:layout_marginTop="14dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>

        <TextView
            android:id="@+id/edit_btn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Edit Photo"
            android:textColor="@color/white"
            android:layout_marginBottom="10dp"
            android:background="@drawable/edit_photo_btn"
            android:gravity="center"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="@id/guideline"
            app:layout_constraintBottom_toBottomOf="parent"
            />

        <ImageView
            android:id="@+id/shapes"
            android:layout_width="50dp"
            android:layout_height="70dp"
            android:src="@drawable/shapes"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginEnd="80dp"
            app:layout_constraintTop_toBottomOf="@id/description"/>

</androidx.constraintlayout.widget.ConstraintLayout>

    <TextView
        android:id="@+id/main_features_heading"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="MAIN FEATURES"
        android:fontFamily="@font/poppins_semibold"
        android:textColor="#262537"
        android:textSize="14sp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="120dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/rectangle_box"/>

    <View
        android:id="@+id/mainfeature_underline"
        android:layout_width="0dp"
        android:layout_height="3dp"
        android:layout_marginTop="-6dp"
        android:background="#6366F1"
        app:layout_constraintTop_toBottomOf="@id/main_features_heading"
        app:layout_constraintStart_toStartOf="@id/gps"
        app:layout_constraintEnd_toEndOf="@id/gps"/>


    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/main_features"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@color/white">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/camera"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:background="@drawable/camera_bg"
            android:layout_marginStart="14dp"
            app:layout_constraintStart_toStartOf="parent"
           app:layout_constraintBottom_toTopOf="@id/mainfeature_underline"
            app:layout_constraintBottom_toBottomOf="parent"/>

        <TextView
            android:id="@+id/camera_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Camera"
            app:layout_constraintStart_toStartOf="parent"/>

        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/camera"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            android:layout_marginStart="100dp"/>





    </androidx.constraintlayout.widget.ConstraintLayout>






    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>