<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/white">

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/photobottom"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_begin="320dp" />

    <ImageView
        android:id="@+id/photo"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        app:layout_constraintHeight_percent=".6"
        android:src="@drawable/subscription_screen"
        android:scaleType="fitXY"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>
    <ImageView
        android:id="@+id/crown"
        android:layout_width="53dp"
        android:layout_height="37dp"
        android:src="@drawable/crown"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/photobottom"/>
    <TextView
        android:id="@+id/access_all_feature"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Access All Features"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="@color/black"
        android:layout_marginTop="10dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/crown"/>
    <TextView
        android:id="@+id/option1"
        android:layout_width="200dp"
        android:layout_height="wrap_content"
        android:drawableStart="@drawable/tick"
        android:drawablePadding="10dp"
        android:gravity="center_vertical"
        android:text="Customize stamps freely"
        android:layout_marginStart="20dp"
        android:layout_marginTop="12dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/access_all_feature" />
    <TextView
        android:id="@+id/option2"
        android:layout_width="200dp"
        android:singleLine="true"
        android:layout_height="wrap_content"
        android:drawableStart="@drawable/tick"
        android:gravity="center_vertical"
        android:drawablePadding="10dp"
        android:layout_marginStart="20dp"
        android:ellipsize="none"
        android:text="A wide selection of templates"
        android:layout_marginTop="10dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/option1"
        />
    <TextView
        android:id="@+id/option3"
        android:layout_width="200dp"
        android:layout_height="wrap_content"
        android:drawableStart="@drawable/tick"
        android:gravity="center_vertical"
        android:drawablePadding="10dp"
        android:layout_marginStart="20dp"
        android:text="No ads forever"
        android:layout_marginTop="10dp"
        app:layout_constraintTop_toBottomOf="@id/option2"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>


<androidx.constraintlayout.widget.ConstraintLayout
    android:id="@+id/box1"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/rectangle"
    android:layout_marginHorizontal="40dp"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintEnd_toEndOf="parent"
    app:layout_constraintTop_toBottomOf="@id/option3"
    android:layout_marginTop="23dp">
    <ImageView
        android:id="@+id/radiobutton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/radiobutton"
        android:layout_marginVertical="16dp"
        android:layout_marginStart="16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>

    <TextView
        android:id="@+id/boxtext1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Yearly"
        android:textSize="14sp"
        android:layout_marginStart="42dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="23dp"
        app:layout_constraintStart_toStartOf="@id/radiobutton"
        app:layout_constraintStart_toEndOf="parent"/>

    <TextView
        android:id="@+id/boxtext2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Rs 3,600.00"
        android:layout_marginStart="12dp"
        android:layout_marginBottom="8dp"
        android:layout_marginTop="2dp"
        app:layout_constraintStart_toEndOf="@id/radiobutton"
        app:layout_constraintTop_toBottomOf="@id/boxtext1"/>

    <TextView
        android:id="@+id/perweek"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Rs 69.23/Week"
        android:layout_marginVertical="17dp"
        android:layout_marginStart="162dp"
        android:layout_marginEnd="17dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>


</androidx.constraintlayout.widget.ConstraintLayout>



    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/box2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/rectangle"
        android:layout_marginHorizontal="40dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/box1"
        android:layout_marginTop="12dp">
        <ImageView
            android:id="@+id/radiobutton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/radiobutton"
            android:layout_marginVertical="16dp"
            android:layout_marginStart="16dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>

        <TextView
            android:id="@+id/boxtext1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Weekly"
            android:textSize="14sp"
            android:layout_marginStart="42dp"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="23dp"
            app:layout_constraintStart_toStartOf="@id/radiobutton"
            app:layout_constraintStart_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"/>


        <TextView
            android:id="@+id/perweek"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Rs 69.23/Week"
            android:layout_marginVertical="17dp"
            android:layout_marginStart="162dp"
            android:layout_marginEnd="17dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>


    </androidx.constraintlayout.widget.ConstraintLayout>


</androidx.constraintlayout.widget.ConstraintLayout>