<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/white">

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/photobottom"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.42" />
    <ImageView
        android:id="@+id/photo"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        app:layout_constraintHeight_percent=".6"
        android:src="@drawable/subscription_screen"
        android:scaleType="fitXY"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <ImageView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/closebtn"
        android:layout_marginEnd="20dp"
        android:layout_marginTop="55dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <ImageView
        android:id="@+id/crown"
        android:layout_width="53dp"
        android:layout_height="37dp"
        android:src="@drawable/crown"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/photobottom"/>
    <TextView
        android:id="@+id/access_all_feature"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Access All Features"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="@color/black"
        android:layout_marginTop="10dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/crown"/>
    <TextView
        android:id="@+id/option1"
        android:layout_width="200dp"
        android:layout_height="wrap_content"
        android:drawableStart="@drawable/tick"
        android:drawablePadding="10dp"
        android:gravity="center_vertical"
        android:text="Customize stamps freely"
        android:fontFamily="@font/poppins_medium"
        android:textSize="12sp"
        android:layout_marginStart="20dp"
        android:layout_marginTop="12dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/access_all_feature" />
    <TextView
        android:id="@+id/option2"
        android:layout_width="200dp"
        android:singleLine="true"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:drawablePadding="10dp"
        android:layout_marginStart="20dp"
        android:ellipsize="none"
        android:text="A wide selection of templates"
        android:fontFamily="@font/poppins_medium"
        android:textSize="12sp"
        android:layout_marginTop="10dp"
        app:drawableStartCompat="@drawable/tick"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/option1"
        />
    <TextView
        android:id="@+id/option3"
        android:layout_width="200dp"
        android:layout_height="wrap_content"
        android:drawableStart="@drawable/tick"
        android:gravity="center_vertical"
        android:drawablePadding="10dp"
        android:layout_marginStart="20dp"
        android:text="No ads forever"
        android:fontFamily="@font/poppins_medium"
        android:textSize="12sp"
        android:layout_marginTop="10dp"
        app:layout_constraintTop_toBottomOf="@id/option2"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>


    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/box1"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@drawable/rectangle"
        android:layout_marginHorizontal="40dp"
        android:layout_marginTop="12dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/option3">

        <ImageView
            android:id="@+id/radiobutton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:src="@drawable/radiobutton"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

        <TextView
            android:id="@+id/boxtext1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginTop="12dp"
            android:text="Yearly"
            android:textSize="14sp"
            app:layout_constraintStart_toEndOf="@id/radiobutton"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/boxtext2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="12dp"
            android:text="Rs 3,600.00"
            app:layout_constraintStart_toStartOf="@id/boxtext1"
            app:layout_constraintTop_toBottomOf="@id/boxtext1"
            app:layout_constraintBottom_toBottomOf="parent" />

        <TextView
            android:id="@+id/perweek"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="17dp"
            android:text="Rs 69.23/Week"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>



    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/box2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/rectangle"
        android:layout_marginHorizontal="40dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/box1"
        android:layout_marginTop="12dp">
        <ImageView
            android:id="@+id/radiobutton2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/radiobutton"
            android:layout_marginVertical="16dp"
            android:layout_marginStart="16dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>

        <TextView
            android:id="@+id/boxtext2nd"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Weekly"
            android:textSize="14sp"
            android:layout_marginStart="42dp"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="23dp"
            app:layout_constraintStart_toStartOf="@id/radiobutton2"
            app:layout_constraintStart_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"/>


        <TextView
            android:id="@+id/perweeks"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Rs 69.23/Week"
            android:layout_marginVertical="17dp"
            android:layout_marginStart="162dp"
            android:layout_marginEnd="17dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>


    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.constraintlayout.widget.ConstraintLayout

        android:id="@+id/freetrial"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/green_rectangle"
        android:layout_marginHorizontal="14dp"
        app:layout_constraintBottom_toTopOf="@id/box2"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" >


    </androidx.constraintlayout.widget.ConstraintLayout>

    <TextView
        android:id="@+id/trial_description"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:text="3 days free trial, PKR 2,900/yearly after trial ends.\nCancel anytime at least 24 hours before renewal."
        android:textColor="@color/Slate"
        android:fontFamily="@font/poppins_medium"
        android:textSize="14sp"
        app:layout_constraintTop_toBottomOf="@id/box2"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/btnfreetrial"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:layout_marginHorizontal="40dp"
        android:background="@drawable/green_rectangle"
        android:gravity="center"
        android:text="Continue to Free Trial"
        android:textColor="@color/white"
        android:textSize="18sp"
        android:fontFamily="@font/poppins_medium"
        app:layout_constraintTop_toBottomOf="@id/trial_description"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />
    <TextView
        android:id="@+id/term_of_use"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Term Of Use  |  "
        android:textSize="12sp"
        android:textColor="@color/Slate"
        app:layout_constraintTop_toBottomOf="@id/btnfreetrial"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/privacy_policy"
        app:layout_constraintHorizontal_chainStyle="packed" />

    <TextView
        android:id="@+id/privacy_policy"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Privacy Policy  |  "
        android:textSize="12sp"
        android:textColor="@color/Slate"
        app:layout_constraintTop_toBottomOf="@id/btnfreetrial"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@id/term_of_use"
        app:layout_constraintEnd_toStartOf="@id/subscriptions_detail" />

    <TextView
        android:id="@+id/subscriptions_detail"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Subscription Detail"
        android:textSize="12sp"
        android:textColor="@color/Slate"
        app:layout_constraintTop_toBottomOf="@id/btnfreetrial"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@id/privacy_policy"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>