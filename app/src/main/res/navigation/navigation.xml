<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/navigation"
    app:startDestination="@id/splashFragment">

    <fragment
        android:id="@+id/splashFragment"
        android:name="com.example.gpsmapcamera.ui.SplashFragment"
        android:label="SplashFragment"
        tools:layout="@layout/fragment_splash">
        <action
            android:id="@+id/action_splashFragment_to_languagesFragment"
            app:destination="@id/languagesFragment"
            app:popUpTo="@id/splashFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/languagesFragment"
        android:name="com.example.gpsmapcamera.ui.LanguagesFragment"
        android:label="LanguagesFragment"
        tools:layout="@layout/fragment_languages">
        <action
            android:id="@+id/action_languagesFragment_to_onboarding1Fragment"
            app:destination="@id/onboardingContainerFragment" />
    </fragment>

    <fragment
        android:id="@+id/onboardingContainerFragment"
        android:name="com.example.gpsmapcamera.ui.OnboardingContainerFragment"
        android:label="OnboardingContainerFragment"
        tools:layout="@layout/fragment_onboarding_container">
        <action
            android:id="@+id/action_onboardingContainer_to_subscriptionFragment"
            app:destination="@id/subscriptionFragment"
            app:popUpTo="@id/onboardingContainerFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/onboarding1Fragment"
        android:name="com.example.gpsmapcamera.ui.Onboarding1Fragment"
        android:label="fragment_onboarding1"
        tools:layout="@layout/fragment_onboarding1">
        <action
            android:id="@+id/action_onboarding1Fragment_to_onboarding2Fragment"
            app:destination="@id/onboarding2Fragment" />
        <action
            android:id="@+id/action_onboarding1Fragment_self"
            app:destination="@id/onboarding1Fragment" />
    </fragment>

    <fragment
        android:id="@+id/onboarding2Fragment"
        android:name="com.example.gpsmapcamera.ui.Onboarding2Fragment"
        android:label="fragment_onboarding2"
        tools:layout="@layout/fragment_onboarding2">
        <action
            android:id="@+id/action_onboarding2Fragment_to_onboarding3Fragment"
            app:destination="@id/onboarding3Fragment" />
    </fragment>

    <fragment
        android:id="@+id/onboarding3Fragment"
        android:name="com.example.gpsmapcamera.ui.Onboarding3Fragment"
        android:label="fragment_onboarding3"
        tools:layout="@layout/fragment_onboarding3">
        <action
            android:id="@+id/action_onboarding3Fragment_to_subscriptionFragment"
            app:destination="@id/subscriptionFragment"
            app:popUpTo="@id/onboarding3Fragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/subscriptionFragment"
        android:name="com.example.gpsmapcamera.ui.SubscriptionFragment"
        android:label="SubscriptionFragment"
        tools:layout="@layout/fragment_subscription">
        <action
            android:id="@+id/action_subscriptionFragment_to_homeFragment"
            app:destination="@id/homeFragment"
            app:popUpTo="@id/subscriptionFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/homeFragment"
        android:name="com.example.gpsmapcamera.ui.HomeFragment"
        android:label="HomeFragment"
        tools:layout="@layout/fragment_home">
        <action
            android:id="@+id/action_homeFragment_to_subscriptionFragment"
            app:destination="@id/subscriptionFragment" />
        <action
            android:id="@+id/action_homeFragment_to_settingFragment"
            app:destination="@id/settingFragment" />
        <action
            android:id="@+id/action_homeFragment_to_fragmentCamera"
            app:destination="@id/fragmentCamera" />
        <action
            android:id="@+id/action_homeFragment_to_fragmentDirectChat"
            app:destination="@id/fragmentDirectChat" />
    </fragment>

    <fragment
        android:id="@+id/settingFragment"
        android:name="com.example.gpsmapcamera.ui.SettingsFragment"
        android:label="SettingsFragment"
        tools:layout="@layout/fragment_setting">
        <action
            android:id="@+id/action_fragmentSetting_to_fragmentSubscription"
            app:destination="@id/subscriptionFragment" />
    </fragment>

    <fragment
        android:id="@+id/fragmentCamera"
        android:name="com.example.gpsmapcamera.ui.FragmentCamera"
        android:label="Camera"
        tools:layout="@layout/fragment_camera" />

    <fragment
        android:id="@+id/fragmentDirectChat"
        android:name="com.example.gpsmapcamera.ui.Fragment_direct_chat"
        android:label="DirectChat"
        tools:layout="@layout/fragment_direct_chat">
        <action
            android:id="@+id/action_fragmentDirectChat_to_fragmentHistory"
            app:destination="@id/fragmentHistory" />
    </fragment>

    <fragment
        android:id="@+id/fragmentHistory"
        android:name="com.example.gpsmapcamera.ui.Fragment_history"
        android:label="History"
        tools:layout="@layout/fragment_history" />

</navigation>